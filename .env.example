# Copy this file to .env and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings). .env is git-ignored so secrets never reach GitHub.

# ---- Public values: safe to use in the browser ----
# Project Settings → Data API → Project URL
VITE_SUPABASE_URL=
# Project Settings → API Keys → "anon" / "publishable" key
VITE_SUPABASE_ANON_KEY=

# ---- Backend only: NEVER put these in frontend code ----
# Same Project URL as above (the backend uses it to check login tokens)
SUPABASE_URL=
# Connect button (top of the dashboard) → "Session pooler" → URI.
# Replace [YOUR-PASSWORD] with your database password, and change "postgresql://" to "postgresql+psycopg://"
DATABASE_URL=
