# Copy this file to .env and fill in the values from your Supabase project.
# .env is git-ignored so secrets never reach GitHub.

# ---- Public values: safe to use in the browser ----
# https://<project id>.supabase.co  (the project id is in the dashboard's address bar)
VITE_SUPABASE_URL=
# Project Settings → API Keys → "publishable" key (sb_publishable_...). NEVER the secret key.
VITE_SUPABASE_ANON_KEY=

# ---- Backend only: NEVER put these in frontend code ----
# Same as VITE_SUPABASE_URL (the backend uses it to check login tokens)
SUPABASE_URL=

# Development: the local database from docker-compose.yml.
# Online (Phase 6): the Supabase database instead, from the dashboard's Connect button → Session pooler,
# with "postgresql://" changed to "postgresql+psycopg://".
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/eartraining
